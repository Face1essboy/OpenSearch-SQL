#reason: The question requires display in order: "level of education" and "occupation". The filtering conditions include age between 20 and 35, and income K of 2000 and below.
#columns: Customers.EDUCATIONNUM, Customers.OCCUPATION, Customers.age, Demog.INCOME_K
#values: age BETWEEN 20 AND 35 refer to Customers.age >= 20 AND Customers.age <= 35, income K of 2000 and below refer to Demog.INCOME_K < 2000
#SELECT: level of education refer to Customers.EDUCATIONNUM, occupation refer to Customers.OCCUPATION
#SQL-like: Show Customers.EDUCATIONNUM, Customers.OCCUPATION WHERE Customers.age BETWEEN 20 AND 35 AND Demog.INCOME_K < 2000
#SQL: SELECT T1.EDUCATIONNUM, T1.OCCUPATION FROM Customers AS T1 INNER JOIN Demog AS T2 ON T1.GEOID = T2.GEOID WHERE T2.INCOME_K < 2000 AND T1.age >= 20 AND T1.age <= 35

